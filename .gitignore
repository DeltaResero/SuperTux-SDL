#
# NOTE! Please use 'git ls-files -i --exclude-standard'
# command after changing this file, to see if there are
# any tracked files which get ignored after the change.
#

# --- Temporary Patch Files ---
# Ignore generated patches so they don't clutter the repo
*.patch
*.diff
patches
series

# --- Compiled Object Files & Libraries ---
*.o
*.o.*
*.a
*.la
*.lo
*.so
*.so.*
*.dll
*.dylib
*.exe
*.out
*.obj

# --- Wii / Console Build Artifacts ---
# We ignore the resulting binaries, but keep the source
*.elf
*.dol
*.map
*.elf.map
*.bin

# --- Main Executable (Linux/Unix build) ---
# This is the binary generated by the build system
supertux
supertux2

# --- Compression / Archives ---
*.7z
*.bz2
*.gz
*.lzma
*.lzo
*.lz4
*.rar
*.tar
*.tgz
*.xz
*.zip

# --- Text / Editor Backups ---
*.bak
*.orig
*.rej
*~
\#*#
*.swp
*.swo
*.*~

# --- Translations ---
# Templates generated by the build system
*.pot

# --- Autotools / GNU Build System ---
# Generated files that shouldn't be tracked
Jamconfig
Jamconfig.in
Makefile
Makefile.in
.deps
.libs
aclocal.m4
autom4te.cache/
autoscan.log
compile
config.guess
config.h
config.h.in
config.log
config.status
config.sub
configure
configure.scan
depcomp
install-sh
libtool
ltmain.sh
missing
mkinstalldirs
py-compile
stamp-h?
supertux.spec
symlink-tree
texinfo.tex
ylwrap

# --- Libtool Macros ---
# Often generated/symlinked by autogen.sh
libtool.m4
ltoptions.m4
ltsugar.m4
ltversion.m4
lt~obsolete.m4

# --- Jam Build System ---
# Your repo uses Jam, these are generated by it
Jamconfig.in
Jamconfig
bin/
gen/
jam0.log

# --- CMake ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CPackConfig.cmake
CPackSourceConfig.cmake
install_manifest.txt

# --- Build Directory ---
# Ignores the entire build folder where you run cmake
build/
build*/

# --- IDE / Tooling ---
# General IDE folders (optional, but good practice)
.vscode/
.idea/
*.DS_Store

# --- Python ---
# Ignore compiled python but keep .py scripts
__pycache__/
*.pyc

# --- Tags ---
GPATH
GRTAGS
GSYMS
GTAGS
cscope.*
ncscope.*

# --- EXCEPTIONS ---
# Ensure we don't ignore git's own config
!.gitignore
